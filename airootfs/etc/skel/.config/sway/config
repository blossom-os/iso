# homeOS Sway (Install environment) Configuration

# Input configuration
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

for_window [title="."] floating enable

bar {
    position top
    # Keep in mind that the current directory of this config file is $HOME
    status_command while ~/.config/sway/status.sh; do sleep 0.1; done

    # Disable workspace buttons
    workspace_buttons no

    colors {
        statusline #000000
        background #808080
        inactive_workspace #808080 #808080 #5c5c5c
        focused_workspace #000000 #000000 #ffffff
    }

    font pango:DejaVu Sans Mono 10
}

set $mod Mod4
bindsym $mod+Return exec kitty
bindsym $mod+Shift+e exec /root/.config/sway/autorun.sh

# Network applet
exec nm-applet

# Set theme
exec gsettings set org.gnome.desktop.interface gtk-theme "Breeze-Dark"
exec gsettings set org.gnome.desktop.interface icon-theme "Breeze Chameleon Dark"
exec gsettings set org.gnome.desktop.interface cursor-theme "Bibata-Modern-Classic"

# xfce-polkit for privilege escalation dialogs
exec /usr/lib/xfce-polkit/xfce-polkit

# Auto-launch homeOS recovery on startup
exec /root/.config/sway/autorun.sh