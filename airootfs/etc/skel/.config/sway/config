# blossomOS Sway (Install environment) Configuration

# Input configuration
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

for_window [title="."] floating enable

set $mod Mod4
bindsym $mod+Return exec kitty
bindsym $mod+Shift+e exec /home/liveuser/.config/sway/autorun.sh

# Set theme
exec gsettings set org.gnome.desktop.interface gtk-theme "Breeze-Dark"
exec gsettings set org.gnome.desktop.interface icon-theme "Breeze Chameleon Dark"
exec gsettings set org.gnome.desktop.interface cursor-theme "Bibata-Modern-Classic"

seat * {
    xcursor_theme "Bibata-Modern-Classic" 24
}

# KDE Polkit agent
exec /usr/lib/polkit-kde-authentication-agent-1 &

# Wallpaper
output * bg ~/.bg.png fill

# Window styles
default_border none

# Auto-launch blossomOS recovery on startup
exec /home/liveuser/.config/sway/autorun.sh